root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 160
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ktlint_function_naming_ignore_when_annotated_with = Composable
# Wildcard-free imports are enforced; star imports never appear in this codebase.
ij_kotlin_name_count_to_use_star_import = 999
ij_kotlin_name_count_to_use_star_import_for_members = 999
# Signature and argument wrapping follow the existing code (and IDE formatting)
# rather than ktlint's stricter layout.
ktlint_standard_class-signature = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_function-literal = disabled
ktlint_standard_binary-expression-wrapping = disabled
ktlint_standard_blank-line-between-when-conditions = disabled
# Files are named for what they hold (Records.kt, Color.kt), not their first class.
ktlint_standard_filename = disabled

[*.{yml,yaml,json,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
