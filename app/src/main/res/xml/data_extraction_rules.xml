<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. Photos and caches are private/large and are never backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="photos/" />
        <exclude domain="file" path="food_cache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="food_cache/" />
    </device-transfer>
</data-extraction-rules>
