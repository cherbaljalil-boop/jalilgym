<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds without Health Connect (jalilgym.healthConnectInRelease=false). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_STEPS" tools:node="remove" />

    <application>
        <activity
            android:name="com.chdjalil.jalilgym.HealthPermissionsActivity"
            tools:node="remove" />
        <activity-alias
            android:name="com.chdjalil.jalilgym.ViewPermissionUsageActivity"
            tools:node="remove" />
    </application>
</manifest>
